# Copy to .env.local. Only the Python backend reads these values.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Optional intake connectors. Pulls happen only when you click Sync.
# Prefer a scoped OAuth token for Zendesk; API token fields support existing accounts.
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_TOKEN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
TICKET_API_URL=
TICKET_API_TOKEN=
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
