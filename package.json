{
  "name": "laya-jev-lab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/next.cjs dev --hostname 127.0.0.1 --port 5180",
    "build": "node scripts/next.cjs build",
    "start": "node scripts/next.cjs start --hostname 127.0.0.1 --port 5180",
    "lint": "eslint app next.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app next.config.ts",
    "test:ui": "node --test tests/ui.test.cjs",
    "check:public": "python scripts/check_public.py"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module"
}
