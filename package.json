{
  "name": "laya-jev-lab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/next.cjs dev --hostname 127.0.0.1 --port 5180",
    "build": "node scripts/next.cjs build",
    "start": "node scripts/next.cjs start --hostname 127.0.0.1 --port 5180",
    "lint": "eslint app next.config.ts",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "format": "prettier --write app next.config.ts",
    "test:ui": "node --test tests/ui.test.cjs",
    "check:public": "python scripts/check_public.py"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "typescript-eslint": "8.70.1"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.3"
  }
}
