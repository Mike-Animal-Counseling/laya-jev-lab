FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    SERVICE_DATA_DIR=/app/var/cloud SERVICE_MODEL_PATH=/app/models/ticket-finetuned-v5 \
    SERVICE_BIND=0.0.0.0 SERVICE_PORT=8780
WORKDIR /app
COPY deploy/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes \
    --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu \
    -r /tmp/requirements.lock \
    && useradd --uid 10001 --create-home app \
    && mkdir -p /app/var/cloud /app/models \
    && chown -R app:app /app/var /app/models
COPY --chown=app:app ticket_engine ./ticket_engine
COPY --chown=app:app backend ./backend
COPY --chown=app:app projects ./projects
COPY --chown=app:app service ./service
COPY LICENSE NOTICE.md MODEL_CARD.md ./
COPY licenses ./licenses
USER app
EXPOSE 8780
CMD ["python", "-m", "service.server"]
